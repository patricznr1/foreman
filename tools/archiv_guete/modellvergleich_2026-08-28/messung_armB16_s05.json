{"lauf": "armB16_s05", "anfragedatei": "goldset_v2_anfragen.yaml", "basis": "in-container arm=armB16 modell=Snowflake/snowflake-arctic-embed-l-v2.0 max_distance=0.5", "quellen": ["note", "maintenance", "alarm"], "k": 15, "einbettungsmodell": "Snowflake/snowflake-arctic-embed-l-v2.0", "prioritaet": "st_only", "max_distance": 0.5, "laeufe": [{"anfrage_id": "B01", "anfrage": "Undichtigkeit an Achse", "machine_id": null, "dauer_s": 7.295, "fehler": null, "treffer": []}, {"anfrage_id": "B02", "anfrage": "Fleck auf Bild", "machine_id": null, "dauer_s": 0.162, "fehler": null, "treffer": [{"rang": 1, "schluessel": "note:20", "source_type": "note", "id": 20, "machine_id": 12, "timestamp": "2026-02-06T08:10:00+00:00", "gefunden_von": ["note"], "excerpt": "VS-01 hat auf dem Bild einen dunklen Fleck, immer an derselben Stelle, egal welches Teil. Teile werden deswegen abgewiesen.", "detail": {"shift": "frueh"}}]}, {"anfrage_id": "B03", "anfrage": "Lagerschaden am Lagerbock", "machine_id": null, "dauer_s": 0.217, "fehler": null, "treffer": []}, {"anfrage_id": "B04", "anfrage": "Dosierunregelmäßigkeiten", "machine_id": null, "dauer_s": 0.109, "fehler": null, "treffer": []}, {"anfrage_id": "B05", "anfrage": "Schleppfehler an AX", "machine_id": null, "dauer_s": 0.133, "fehler": null, "treffer": [{"rang": 1, "schluessel": "note:106", "source_type": "note", "id": 106, "machine_id": 3, "timestamp": "2026-05-28T07:20:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-03 geht seit gestern in Schleppfehler. Gestern wurde das Programm angepasst, Beschleunigung höher. Zusammenhang liegt nahe.", "detail": {"shift": "frueh"}}, {"rang": 2, "schluessel": "note:52", "source_type": "note", "id": 52, "machine_id": 2, "timestamp": "2026-03-17T22:10:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-02 ist heute zweimal in Störung gegangen, Schleppfehler. [PERSON] und weitergelaufen, ohne dass wir was gemacht haben.", "detail": {"shift": "nacht"}}, {"rang": 3, "schluessel": "note:177", "source_type": "note", "id": 177, "machine_id": 2, "timestamp": "2026-08-10T08:30:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-02 hat Schlupf beim Reversieren, man hört das leise Klacken wenn sie umkehrt. Die Korrektur im Programm bleibt keine Schicht stehen.", "detail": {"shift": "frueh"}}, {"rang": 4, "schluessel": "note:66", "source_type": "note", "id": 66, "machine_id": 3, "timestamp": "2026-04-07T18:50:00+00:00", "gefunden_von": ["note"], "excerpt": "An AX-03 klopft es jedes Mal am Umkehrpunkt, ein einzelner Schlag. Sonst läuft sie sauber durch.", "detail": {"shift": "spaet"}}]}, {"anfrage_id": "B06", "anfrage": "Durckabfall Hydraulik", "machine_id": null, "dauer_s": 0.135, "fehler": null, "treffer": []}, {"anfrage_id": "B07", "anfrage": "Nullpunktverschiebung an AX", "machine_id": null, "dauer_s": 0.33, "fehler": null, "treffer": [{"rang": 1, "schluessel": "note:41", "source_type": "note", "id": 41, "machine_id": 1, "timestamp": "2026-03-03T09:05:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-01 setzt die Teile nicht mehr mittig ab, immer in dieselbe Richtung daneben. Nullpunkt neu gesetzt, hält bis Schichtende.", "detail": {"shift": "frueh"}}]}, {"anfrage_id": "B08", "anfrage": "Ruckeln beim Hub", "machine_id": null, "dauer_s": 0.193, "fehler": null, "treffer": [{"rang": 1, "schluessel": "note:183", "source_type": "note", "id": 183, "machine_id": 9, "timestamp": "2026-08-11T20:20:00+00:00", "gefunden_von": ["note"], "excerpt": "PR-03 stoppt im Hub kurz, sieht aus wie Ruckeln. Die Fahne vom Endschalter hat sich gelöst und schaltet zwischendurch.", "detail": {"shift": "nacht"}}]}, {"anfrage_id": "B09", "anfrage": "Versatz an PR", "machine_id": null, "dauer_s": 0.151, "fehler": null, "treffer": [{"rang": 1, "schluessel": "note:140", "source_type": "note", "id": 140, "machine_id": 7, "timestamp": "2026-07-01T11:10:00+00:00", "gefunden_von": ["note"], "excerpt": "Der Versatz an PR-01 ist geblieben. Werkzeug wurde letzte Woche gewechselt, seitdem ist es so.", "detail": {"shift": "frueh"}}]}, {"anfrage_id": "B10", "anfrage": "Öl Temperatur an PR", "machine_id": null, "dauer_s": 0.118, "fehler": null, "treffer": [{"rang": 1, "schluessel": "maintenance:112", "source_type": "maintenance", "id": 112, "machine_id": 9, "timestamp": "2026-07-17T04:30:00+00:00", "gefunden_von": ["maintenance"], "excerpt": "Prüfung Ölkreis PR-03. Thermostatventil des Kühlers klemmt in Bypass-Stellung, Öl wird am Kühler vorbeigeführt. Ventil ersetzt, Öl gewechselt (HLP 46), Temperatur im Betrieb …", "detail": {"type": "inspection"}}, {"rang": 2, "schluessel": "note:72", "source_type": "note", "id": 72, "machine_id": 7, "timestamp": "2026-04-10T18:10:00+00:00", "gefunden_von": ["note"], "excerpt": "PR-01 Öltemperatur oben. In der Nacht läuft die Presse sauber, tagsüber nicht.", "detail": {"shift": "spaet"}}, {"rang": 3, "schluessel": "note:165", "source_type": "note", "id": 165, "machine_id": 7, "timestamp": "2026-07-30T12:10:00+00:00", "gefunden_von": ["note"], "excerpt": "Alle drei Pressen haben heute warmes Öl, nicht nur PR-01. Draußen 34 Grad und das Hallentor stand den ganzen Vormittag offen.", "detail": {"shift": "spaet"}}, {"rang": 4, "schluessel": "note:175", "source_type": "note", "id": 175, "machine_id": 8, "timestamp": "2026-08-07T07:10:00+00:00", "gefunden_von": ["note"], "excerpt": "An PR-02 ist nichts undicht, Ölstand steht seit vier Wochen gleich. Dafür ist der Tank auffällig warm.", "detail": {"shift": "frueh"}}, {"rang": 5, "schluessel": "note:87", "source_type": "note", "id": 87, "machine_id": 9, "timestamp": "2026-05-07T04:30:00+00:00", "gefunden_von": ["note"], "excerpt": "An PR-03 sieht man Reibspuren auf der Ram-Führung, blank gelaufen. Öl steht oben im Behälter.", "detail": {"shift": "frueh"}}]}]}