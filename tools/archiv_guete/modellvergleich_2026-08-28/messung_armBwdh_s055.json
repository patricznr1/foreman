{"lauf": "armBwdh_s055", "anfragedatei": "goldset_v2_anfragen.yaml", "basis": "in-container arm=armBwdh modell=Snowflake/snowflake-arctic-embed-l-v2.0 max_distance=0.55", "quellen": ["note", "maintenance", "alarm"], "k": 15, "einbettungsmodell": "Snowflake/snowflake-arctic-embed-l-v2.0", "prioritaet": "st_only", "max_distance": 0.55, "laeufe": [{"anfrage_id": "B01", "anfrage": "Undichtigkeit an Achse", "machine_id": null, "dauer_s": 5.114, "fehler": null, "treffer": []}, {"anfrage_id": "B02", "anfrage": "Fleck auf Bild", "machine_id": null, "dauer_s": 5.083, "fehler": null, "treffer": [{"rang": 1, "schluessel": "note:20", "source_type": "note", "id": 20, "machine_id": 12, "timestamp": "2026-02-06T08:10:00+00:00", "gefunden_von": ["note"], "excerpt": "VS-01 hat auf dem Bild einen dunklen Fleck, immer an derselben Stelle, egal welches Teil. Teile werden deswegen abgewiesen.", "detail": {"shift": "frueh"}}]}, {"anfrage_id": "B03", "anfrage": "Lagerschaden am Lagerbock", "machine_id": null, "dauer_s": 4.729, "fehler": null, "treffer": []}, {"anfrage_id": "B04", "anfrage": "Dosierunregelmäßigkeiten", "machine_id": null, "dauer_s": 4.262, "fehler": null, "treffer": []}, {"anfrage_id": "B05", "anfrage": "Schleppfehler an AX", "machine_id": null, "dauer_s": 5.182, "fehler": null, "treffer": [{"rang": 1, "schluessel": "note:106", "source_type": "note", "id": 106, "machine_id": 3, "timestamp": "2026-05-28T07:20:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-03 geht seit gestern in Schleppfehler. Gestern wurde das Programm angepasst, Beschleunigung höher. Zusammenhang liegt nahe.", "detail": {"shift": "frueh"}}, {"rang": 2, "schluessel": "note:52", "source_type": "note", "id": 52, "machine_id": 2, "timestamp": "2026-03-17T22:10:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-02 ist heute zweimal in Störung gegangen, Schleppfehler. [PERSON] und weitergelaufen, ohne dass wir was gemacht haben.", "detail": {"shift": "nacht"}}, {"rang": 3, "schluessel": "note:177", "source_type": "note", "id": 177, "machine_id": 2, "timestamp": "2026-08-10T08:30:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-02 hat Schlupf beim Reversieren, man hört das leise Klacken wenn sie umkehrt. Die Korrektur im Programm bleibt keine Schicht stehen.", "detail": {"shift": "frueh"}}, {"rang": 4, "schluessel": "note:66", "source_type": "note", "id": 66, "machine_id": 3, "timestamp": "2026-04-07T18:50:00+00:00", "gefunden_von": ["note"], "excerpt": "An AX-03 klopft es jedes Mal am Umkehrpunkt, ein einzelner Schlag. Sonst läuft sie sauber durch.", "detail": {"shift": "spaet"}}, {"rang": 5, "schluessel": "note:174", "source_type": "note", "id": 174, "machine_id": 1, "timestamp": "2026-08-06T20:30:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-01 wirft sprunghaft eine Fehlermeldung und steht. Zweimal in der Nacht, jeweils weggedrückt und weiter.", "detail": {"shift": "nacht"}}, {"rang": 6, "schluessel": "note:117", "source_type": "note", "id": 117, "machine_id": 4, "timestamp": "2026-06-09T11:40:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-04 verschleppt die Position beim Richtungswechsel. Wenn sie durchfährt ohne Halt, passt es.", "detail": {"shift": "frueh"}}, {"rang": 7, "schluessel": "note:197", "source_type": "note", "id": 197, "machine_id": 12, "timestamp": "2026-08-21T11:10:00+00:00", "gefunden_von": ["note"], "excerpt": "Der Versatz kommt von AX-03, die legt schon schief ein. An der Endkontrolle ist nichts falsch.", "detail": {"shift": "frueh"}}, {"rang": 8, "schluessel": "note:159", "source_type": "note", "id": 159, "machine_id": 3, "timestamp": "2026-07-22T08:15:00+00:00", "gefunden_von": ["note"], "excerpt": "Lager an AX-03 geprüft, sind in Ordnung. Das Problem liegt woanders. Unten tropft Schmierstoff aus der Achse.", "detail": {"shift": "frueh"}}, {"rang": 9, "schluessel": "note:82", "source_type": "note", "id": 82, "machine_id": 1, "timestamp": "2026-04-28T19:30:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-01 macht beim Verfahren ein Geräusch, klingt erst mal nach Führung. Beim genauen Hinsehen schleift die Energiekette am Blech.", "detail": {"shift": "spaet"}}, {"rang": 10, "schluessel": "note:79", "source_type": "note", "id": 79, "machine_id": 2, "timestamp": "2026-04-22T07:50:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-02 setzt daneben. Bevor jemand die Spindel aufmacht: die Greiferbacke ist lose, die hat Spiel und nicht die Achse.", "detail": {"shift": "frueh"}}, {"rang": 11, "schluessel": "note:53", "source_type": "note", "id": 53, "machine_id": 2, "timestamp": "2026-03-19T07:20:00+00:00", "gefunden_von": ["note"], "excerpt": "Wieder eine Störung an AX-02, immer beim schnellen Verfahren. Steckverbindungen sichtgeprüft, alles fest.", "detail": {"shift": "frueh"}}, {"rang": 12, "schluessel": "note:111", "source_type": "note", "id": 111, "machine_id": 2, "timestamp": "2026-06-03T07:00:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-02 klemmt montags in den ersten Fahrten, danach gibt sich das. Steht ja über das Wochenende kalt.", "detail": {"shift": "frueh"}}]}, {"anfrage_id": "B06", "anfrage": "Durckabfall Hydraulik", "machine_id": null, "dauer_s": 5.703, "fehler": null, "treffer": []}, {"anfrage_id": "B07", "anfrage": "Nullpunktverschiebung an AX", "machine_id": null, "dauer_s": 5.232, "fehler": null, "treffer": [{"rang": 1, "schluessel": "note:41", "source_type": "note", "id": 41, "machine_id": 1, "timestamp": "2026-03-03T09:05:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-01 setzt die Teile nicht mehr mittig ab, immer in dieselbe Richtung daneben. Nullpunkt neu gesetzt, hält bis Schichtende.", "detail": {"shift": "frueh"}}, {"rang": 2, "schluessel": "note:117", "source_type": "note", "id": 117, "machine_id": 4, "timestamp": "2026-06-09T11:40:00+00:00", "gefunden_von": ["note"], "excerpt": "AX-04 verschleppt die Position beim Richtungswechsel. Wenn sie durchfährt ohne Halt, passt es.", "detail": {"shift": "frueh"}}]}, {"anfrage_id": "B08", "anfrage": "Ruckeln beim Hub", "machine_id": null, "dauer_s": 5.972, "fehler": null, "treffer": [{"rang": 1, "schluessel": "note:183", "source_type": "note", "id": 183, "machine_id": 9, "timestamp": "2026-08-11T20:20:00+00:00", "gefunden_von": ["note"], "excerpt": "PR-03 stoppt im Hub kurz, sieht aus wie Ruckeln. Die Fahne vom Endschalter hat sich gelöst und schaltet zwischendurch.", "detail": {"shift": "nacht"}}]}, {"anfrage_id": "B09", "anfrage": "Versatz an PR", "machine_id": null, "dauer_s": 5.404, "fehler": null, "treffer": [{"rang": 1, "schluessel": "note:140", "source_type": "note", "id": 140, "machine_id": 7, "timestamp": "2026-07-01T11:10:00+00:00", "gefunden_von": ["note"], "excerpt": "Der Versatz an PR-01 ist geblieben. Werkzeug wurde letzte Woche gewechselt, seitdem ist es so.", "detail": {"shift": "frueh"}}]}, {"anfrage_id": "B10", "anfrage": "Öl Temperatur an PR", "machine_id": null, "dauer_s": 4.753, "fehler": null, "treffer": [{"rang": 1, "schluessel": "maintenance:112", "source_type": "maintenance", "id": 112, "machine_id": 9, "timestamp": "2026-07-17T04:30:00+00:00", "gefunden_von": ["maintenance"], "excerpt": "Prüfung Ölkreis PR-03. Thermostatventil des Kühlers klemmt in Bypass-Stellung, Öl wird am Kühler vorbeigeführt. Ventil ersetzt, Öl gewechselt (HLP 46), Temperatur im Betrieb …", "detail": {"type": "inspection"}}, {"rang": 2, "schluessel": "note:72", "source_type": "note", "id": 72, "machine_id": 7, "timestamp": "2026-04-10T18:10:00+00:00", "gefunden_von": ["note"], "excerpt": "PR-01 Öltemperatur oben. In der Nacht läuft die Presse sauber, tagsüber nicht.", "detail": {"shift": "spaet"}}, {"rang": 3, "schluessel": "note:165", "source_type": "note", "id": 165, "machine_id": 7, "timestamp": "2026-07-30T12:10:00+00:00", "gefunden_von": ["note"], "excerpt": "Alle drei Pressen haben heute warmes Öl, nicht nur PR-01. Draußen 34 Grad und das Hallentor stand den ganzen Vormittag offen.", "detail": {"shift": "spaet"}}, {"rang": 4, "schluessel": "note:175", "source_type": "note", "id": 175, "machine_id": 8, "timestamp": "2026-08-07T07:10:00+00:00", "gefunden_von": ["note"], "excerpt": "An PR-02 ist nichts undicht, Ölstand steht seit vier Wochen gleich. Dafür ist der Tank auffällig warm.", "detail": {"shift": "frueh"}}, {"rang": 5, "schluessel": "note:87", "source_type": "note", "id": 87, "machine_id": 9, "timestamp": "2026-05-07T04:30:00+00:00", "gefunden_von": ["note"], "excerpt": "An PR-03 sieht man Reibspuren auf der Ram-Führung, blank gelaufen. Öl steht oben im Behälter.", "detail": {"shift": "frueh"}}, {"rang": 6, "schluessel": "note:147", "source_type": "note", "id": 147, "machine_id": 9, "timestamp": "2026-07-13T12:50:00+00:00", "gefunden_von": ["note"], "excerpt": "PR-03 Tank ist so heiß dass man die Hand nicht drauf lassen kann. Sie fügt zwar, aber der Druck steht nicht so satt wie sonst.", "detail": {"shift": "spaet"}}]}]}