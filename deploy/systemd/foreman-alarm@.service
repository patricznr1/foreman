# ============================================================
#  FOREMAN — deploy/systemd/foreman-alarm@.service
#  Zweck: Alarm bei einem fehlgeschlagenen Job (deploy/sicherung/melden.sh).
#         Ausgelöst per OnFailure=foreman-alarm@%N.service, %i ist der Name
#         des Jobs; Protokoll: journalctl -u 'foreman-alarm@*'
# ============================================================
[Unit]
Description=FOREMAN: Alarm, %i ist fehlgeschlagen
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=5min
ExecStart=/bin/bash /srv/foreman/app/deploy/sicherung/melden.sh fehler %i
