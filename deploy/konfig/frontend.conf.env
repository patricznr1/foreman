# ============================================================
#  FOREMAN — deploy/konfig/frontend.conf.env
#  Zweck: Laufzeit-Einstellungen des Frontends. Es hat keine Geheimnisse und
#         keine env-Datei unter /srv/foreman/env.
# ============================================================

# Der BFF spricht das Backend im Netz `foreman` über den Dienstnamen an — die
# API ist von außen nicht erreichbar (deploy/caddy/foreman.caddy).
FOREMAN_API_URL=http://backend:8000
