# ============================================================
#  FOREMAN — deploy/konfig/worker.conf.env
#  Zweck: Einstellungen des Live-Workers, die es nur auf dem Server gibt. Keine
#         Geheimnisse. Alle übrigen Namen kommen von Railway nach worker.env
#         (deploy/server/geheimnisse.py) — die beiden Listen sind disjunkt.
# ============================================================

# Dieselbe Gegenstelle wie das Backend (backend.conf.env)
SUBSTRATE_BASE_URL=https://nexus.patric-zeller.de

# Ohne benannte Umgebung startet FOREMAN nicht (config.py). Das Backend bekommt
# den Namen von Railway, der live-worker hat ihn dort nicht.
ENVIRONMENT=production
